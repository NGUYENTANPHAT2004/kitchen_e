# REFERENCE ONLY. This file is not loaded automatically.
# Fill matching values in py-ai/.env locally, not in this tracked example.
# Existing AI implementation uses local models; a hosted LLM client is not wired up.

NODE_BACKEND_URL=http://127.0.0.1:5000
MONGODB_URI=mongodb://127.0.0.1:27018/kitchen_e_local?replicaSet=kitchenLocal
MODEL_PATH=data/models
EMBEDDINGS_PATH=data/embeddings
TEMP_PATH=data/temp
DEFAULT_LANGUAGE=vi
ENABLE_CACHE=false

# Generate a separate random service secret locally. Not a provider-issued key.
SECRET_KEY=

# Must match AI_SERVICE_KEY in Node. Generated automatically by local launchers.
AI_SERVICE_KEY=
INTENT_MODEL_PATH=data/models/intents

# Optional model-access token, only needed when the selected model requires it.
HUGGINGFACE_API_KEY=

# Declared in config.py, but not consumed by the current AI implementation.
# Do not purchase or supply a key just to fill this field.
OPENAI_API_KEY=
