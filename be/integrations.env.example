# REFERENCE ONLY. This file is not loaded automatically.
# Never put real credentials in this tracked example or in frontend VITE_* variables.
# Fill matching variables in be/.env locally; preserve its existing database/secrets.
# start-local.ps1 intentionally overrides external integrations to keep demo mode safe.
# Do not enable real payments until the provider sandbox and callbacks are verified.

# Public origins, without a trailing slash. Replace when a test domain is available.
API_URL=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5173

# VNPay: obtain a sandbox merchant configuration first.
# URL must be the payment URL supplied for the same environment as the credentials.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
# Real refunds are not implemented; there is no refund key that enables them.

# SMTP: the active sendEmail utility reads SMTP_USER, not SMTP_USERNAME.
# Keep local until a controlled email delivery test is authorized.
EMAIL_TRANSPORT=local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=Kitchen E
FROM_EMAIL=

# OAuth: choose only the providers you want to enable.
# Current Google callback: ${API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Current Facebook callback: ${API_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# AWS S3: use a dedicated test bucket with scoped credentials.
# Keep local until upload/read/delete permissions and image delivery are verified.
STORAGE_TYPE=local
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Existing Python service URLs; these are not API keys.
AI_SERVICE_URL=http://127.0.0.1:8000
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000
# Internal Node-to-Python authentication; never expose in frontend variables.
# Local launchers generate and share this key automatically.
AI_SERVICE_KEY=
# Optional dedicated secret for account-bound chat sessions (defaults to JWT_SECRET).
AI_SESSION_SECRET=
